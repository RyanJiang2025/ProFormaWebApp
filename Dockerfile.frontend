FROM python:3.11-slim

WORKDIR /app

# System deps (curl for healthchecks / quick debugging)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ./src/proforma.py ./proforma.py
COPY ./src/webapp.py ./webapp.py

# Streamlit runtime config
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

EXPOSE 8501

# Run the app
CMD ["streamlit", "run", "webapp.py", "--server.address=0.0.0.0", "--server.port=8501"]
